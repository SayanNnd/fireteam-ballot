# Supabase configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Bungie API key (Vercel server endpoint)
BUNGIE_API_KEY=your-bungie-api-key-here

# Local development only: allows the browser to call Bungie through the Vite proxy
VITE_BUNGIE_API_KEY=your-bungie-api-key-here

# Set to "functions" when running the app through `vercel dev` to call local API functions.
# Leave unset for `npm run dev`, which uses the Vite proxy above.
VITE_BUNGIE_LOCAL_MODE=proxy
